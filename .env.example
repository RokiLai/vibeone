# VibeOne environment configuration
# Copy this file to .env and fill in at least VIBEONE_WEB_TOKEN:
#   cp .env.example .env

# Required: web login & API/WebSocket auth token (use a strong random secret)
VIBEONE_WEB_TOKEN=change-me-to-a-strong-random-token

# Optional: bind address and port (keep 127.0.0.1 when behind Tailscale Serve or Caddy)
VIBEONE_HOST=127.0.0.1
VIBEONE_PORT=8765

# Optional: default workspace directory (defaults to the VibeOne project directory)
# VIBEONE_WORKDIR=/path/to/your/workspace

# Optional: Web Push VAPID contact email (required for iOS/browser push notifications;
# must use a real domain, never @localhost)
# VIBEONE_VAPID_SUBJECT=mailto:admin@example.com

# Optional: default permission mode when creating/resuming sessions (default: auto)
# VIBEONE_DEFAULT_MODE=auto

# Optional: profiles to prewarm asynchronously on startup (all | none | profile1,profile2)
# VIBEONE_PREWARM_PROFILES=all

# Optional: macOS LaunchAgent label for .restart_after_turn deferred restarts
# VIBEONE_LAUNCHD_LABEL=local.vibeone
